# ---- DeepSeek API ----
# 必填（除非 MOCK_SEARCH=1）。在 https://platform.deepseek.com/ 创建。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 设为 1 时使用本地假数据，不调用 DeepSeek，也不需要 API Key。
MOCK_SEARCH=0

# ---- 访问保护 ----
# 设置后，所有页面和搜索接口都需要先输入密码。
# 公网部署时强烈建议设置。
ACCESS_PASSWORD=
# 强制 Cookie 的 Secure 标记：1=开启，0=关闭，留空=按 HTTPS 自动判断。
COOKIE_SECURE=

# ---- 限额与缓存 ----
# 每 IP 每分钟允许的搜索请求数，0 表示不限制。
RATE_LIMIT_PER_MINUTE=20
# 每 IP 每分钟允许的登录尝试次数。
LOGIN_RATE_LIMIT_PER_MINUTE=5
# 全站每 UTC 日允许的付费搜索次数（命中缓存不计），0 表示不限制。
DAILY_SEARCH_LIMIT=0
# 成功搜索结果的内存缓存时间（毫秒），0 表示禁用。
SEARCH_CACHE_TTL_MS=300000

# ---- 开发调试 ----
# 仅开发模式使用：通过非 localhost 地址访问 next dev 时，额外允许加载
# HMR/开发资源的来源。逗号分隔，只写主机名（不要协议和端口）。
ALLOWED_DEV_ORIGINS=
